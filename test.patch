diff --git a/test.sh b/test.sh
new file mode 100755
index 0000000..34b8060
--- /dev/null
+++ b/test.sh
@@ -0,0 +1,44 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+OUTPUT_PATH=""
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --output_path)
+      if [[ $# -lt 2 ]]; then
+        echo "--output_path requires a path" >&2
+        exit 1
+      fi
+      OUTPUT_PATH="$2"
+      shift 2
+      ;;
+    *)
+      break
+      ;;
+  esac
+done
+
+MODE="${1:-}"
+
+cd /app
+npm run build
+
+case "$MODE" in
+  base)
+    TESTS=(test/primitive_parser.ts test/composite_parser.ts)
+    ;;
+  new)
+    TESTS=(test/stream_parser.ts)
+    ;;
+  *)
+    echo "Usage: ./test.sh [--output_path <path>] [base|new]" >&2
+    exit 1
+    ;;
+esac
+
+MOCHA_ARGS=(--require ts-node/register)
+if [[ -n "$OUTPUT_PATH" ]]; then
+  MOCHA_ARGS+=(--reporter xunit --reporter-option "output=$OUTPUT_PATH")
+fi
+
+npx mocha "${MOCHA_ARGS[@]}" "${TESTS[@]}"
diff --git a/test/stream_parser.ts b/test/stream_parser.ts
new file mode 100644
index 0000000..88327dd
--- /dev/null
+++ b/test/stream_parser.ts
@@ -0,0 +1,344 @@
+import { deepStrictEqual, ok, rejects, strictEqual, throws } from "assert";
+import { Parser } from "../lib/binary_parser";
+
+interface ParserStreamError extends Error {
+  code: string;
+  bufferedBytes?: number;
+  expectedBytes?: number;
+  maxBufferSize?: number;
+  cause?: unknown;
+}
+
+interface ParserStreamOptions {
+  frameLength(buffer: Uint8Array): number | undefined;
+}
+
+function streaming(parser: Parser): any {
+  return parser;
+}
+
+async function collect(source: AsyncIterable<any>): Promise<any[]> {
+  const values: any[] = [];
+  for await (const value of source) {
+    values.push(value);
+  }
+  return values;
+}
+
+async function* chunks(...values: Uint8Array[]): AsyncIterable<Uint8Array> {
+  for (const value of values) {
+    yield value;
+  }
+}
+
+describe("Streaming parser", () => {
+  it("parses fixed-size records independently of chunk boundaries", async () => {
+    const parser = new Parser().uint8("kind").uint16be("value");
+    const input = chunks(
+      Buffer.from([1]),
+      Buffer.from([0, 2, 3, 0]),
+      Buffer.from([4, 5, 0, 6]),
+    );
+
+    deepStrictEqual(await collect(streaming(parser).parseStream(input)), [
+      { kind: 1, value: 2 },
+      { kind: 3, value: 4 },
+      { kind: 5, value: 6 },
+    ]);
+  });
+
+  it("supports dynamic frame lengths without re-running formatters", async () => {
+    let formatterCalls = 0;
+    const parser = new Parser().uint8("length").array("payload", {
+      type: "uint8",
+      length: "length",
+      formatter(value: number[]) {
+        formatterCalls += 1;
+        return value.join(":");
+      },
+    });
+    const options: ParserStreamOptions = {
+      frameLength(buffer) {
+        return buffer.length === 0 ? undefined : buffer[0] + 1;
+      },
+    };
+
+    const result = await collect(
+      streaming(parser).parseStream(
+        chunks(
+          new Uint8Array([3]),
+          new Uint8Array([4, 5]),
+          new Uint8Array([6, 1, 9]),
+        ),
+        options,
+      ),
+    );
+
+    deepStrictEqual(result, [
+      { length: 3, payload: "4:5:6" },
+      { length: 1, payload: "9" },
+    ]);
+    strictEqual(formatterCalls, 2);
+  });
+
+  it("preserves the first input chunk's binary representation", async () => {
+    const parser = new Parser().buffer("payload", { length: 2 });
+    const buffers = await collect(
+      streaming(parser).parseStream(chunks(Buffer.from([1]), Buffer.from([2]))),
+    );
+    const arrays = await collect(
+      streaming(parser).parseStream(
+        chunks(Buffer.alloc(0), new Uint8Array([3]), new Uint8Array([4])),
+      ),
+    );
+
+    ok(Buffer.isBuffer(buffers[0].payload));
+    ok(arrays[0].payload instanceof Uint8Array);
+    strictEqual(Buffer.isBuffer(arrays[0].payload), false);
+    deepStrictEqual([...buffers[0].payload], [1, 2]);
+    deepStrictEqual([...arrays[0].payload], [3, 4]);
+  });
+
+  it("accepts synchronous iterables of chunks", async () => {
+    const parser = new Parser().uint8("value");
+    const source = [new Uint8Array([1, 2]), new Uint8Array([3])];
+
+    deepStrictEqual(await collect(streaming(parser).parseStream(source)), [
+      { value: 1 },
+      { value: 2 },
+      { value: 3 },
+    ]);
+  });
+
+  it("accepts a numeric frame length for dynamic parsers", async () => {
+    const parser = new Parser().uint8("length").array("payload", {
+      type: "uint8",
+      length: "length",
+    });
+    const source = chunks(new Uint8Array([1, 9, 1, 8]));
+
+    deepStrictEqual(
+      await collect(streaming(parser).parseStream(source, { frameLength: 2 })),
+      [
+        { length: 1, payload: [9] },
+        { length: 1, payload: [8] },
+      ],
+    );
+  });
+
+  it("reports an incomplete trailing frame after complete records", async () => {
+    const parser = new Parser().uint16be("value");
+    const stream = streaming(parser).parseStream(
+      chunks(new Uint8Array([0, 1, 0, 2, 9])),
+    );
+
+    deepStrictEqual(await stream.next(), {
+      done: false,
+      value: { value: 1 },
+    });
+    deepStrictEqual(await stream.next(), {
+      done: false,
+      value: { value: 2 },
+    });
+    await rejects(stream.next(), (error: ParserStreamError) => {
+      strictEqual(error.code, "INCOMPLETE_FRAME");
+      strictEqual(error.bufferedBytes, 1);
+      strictEqual(error.expectedBytes, 2);
+      return true;
+    });
+  });
+
+  it("rejects dynamic frames that exceed the buffer limit", async () => {
+    const parser = new Parser().uint8("value");
+    const stream = streaming(parser).createStream({
+      frameLength: () => undefined,
+      maxBufferSize: 4,
+    });
+
+    await rejects(
+      stream.write(new Uint8Array([1, 2, 3, 4, 5])),
+      (error: ParserStreamError) => {
+        strictEqual(error.code, "BUFFER_LIMIT_EXCEEDED");
+        strictEqual(error.bufferedBytes, 5);
+        strictEqual(error.maxBufferSize, 4);
+        return true;
+      },
+    );
+  });
+
+  it("accepts large chunks containing complete bounded frames", async () => {
+    const parser = new Parser().uint8("value");
+    const values = Array.from({ length: 32 }, (_, index) => index);
+    const stream = streaming(parser).parseStream(
+      chunks(new Uint8Array(values)),
+      {
+        maxBufferSize: 2,
+        highWaterMark: 64,
+      },
+    );
+
+    deepStrictEqual(
+      (await collect(stream)).map((item) => item.value),
+      values,
+    );
+  });
+
+  it("rejects invalid lengths returned by a frame resolver", async () => {
+    const parser = new Parser().uint8("value");
+
+    for (const frameLength of [0, -1, 1.5, Number.POSITIVE_INFINITY]) {
+      const stream = streaming(parser).createStream({
+        frameLength: () => frameLength,
+      });
+      await rejects(
+        stream.write(new Uint8Array([1])),
+        (error: ParserStreamError) => {
+          strictEqual(error.code, "INVALID_FRAME_LENGTH");
+          return true;
+        },
+      );
+    }
+  });
+
+  it("requires explicit framing for dynamically sized parsers", () => {
+    const parser = new Parser().uint8("length").array("payload", {
+      type: "uint8",
+      length: "length",
+    });
+
+    throws(
+      () => streaming(parser).createStream(),
+      /positive frameLength is required/,
+    );
+  });
+
+  it("propagates source failures after already parsed records", async () => {
+    const failure = new Error("source failed");
+    async function* source() {
+      yield new Uint8Array([7]);
+      throw failure;
+    }
+    const stream = streaming(new Parser().uint8("value")).parseStream(source());
+
+    deepStrictEqual(await stream.next(), {
+      done: false,
+      value: { value: 7 },
+    });
+    await rejects(stream.next(), (error) => error === failure);
+  });
+
+  it("propagates parser failures after earlier valid records", async () => {
+    const parser = new Parser().uint8("value", {
+      assert(value) {
+        return typeof value === "number" && value < 2;
+      },
+    });
+    const stream = streaming(parser).parseStream(
+      chunks(new Uint8Array([1, 2])),
+    );
+
+    deepStrictEqual(await stream.next(), {
+      done: false,
+      value: { value: 1 },
+    });
+    await rejects(stream.next(), /Assertion error/);
+  });
+
+  it("supports push-based parsing and applies result backpressure", async () => {
+    const stream = streaming(new Parser().uint8("value")).createStream({
+      highWaterMark: 1,
+    });
+    let writeFinished = false;
+    const write = stream.write(new Uint8Array([1, 2])).then(() => {
+      writeFinished = true;
+    });
+
+    await Promise.resolve();
+    strictEqual(writeFinished, false);
+    strictEqual(stream.bufferedBytes, 0);
+    strictEqual(stream.queuedResults, 2);
+    strictEqual(stream.closed, false);
+    deepStrictEqual(await stream.next(), {
+      done: false,
+      value: { value: 1 },
+    });
+    strictEqual(writeFinished, false);
+    deepStrictEqual(await stream.next(), {
+      done: false,
+      value: { value: 2 },
+    });
+    await write;
+    strictEqual(writeFinished, true);
+    stream.end();
+    strictEqual(stream.closed, true);
+    deepStrictEqual(await stream.next(), { done: true, value: undefined });
+  });
+
+  it("rejects pending reads when aborted", async () => {
+    const controller = new AbortController();
+    const stream = streaming(new Parser().uint8("value")).createStream({
+      signal: controller.signal,
+    });
+    const pending = stream.next();
+
+    controller.abort("cancelled");
+    await rejects(pending, (error: ParserStreamError) => {
+      strictEqual(error.code, "ABORTED");
+      strictEqual(error.cause, "cancelled");
+      return true;
+    });
+    await rejects(stream.write(new Uint8Array([1])), {
+      code: "ABORTED",
+    });
+  });
+
+  it("closes an attached source when iteration ends early", async () => {
+    let returned = 0;
+    let nextValue = 0;
+    const source: AsyncIterable<Uint8Array> = {
+      [Symbol.asyncIterator]() {
+        return {
+          async next() {
+            return {
+              done: false,
+              value: new Uint8Array([nextValue++]),
+            };
+          },
+          async return() {
+            returned += 1;
+            return { done: true, value: undefined };
+          },
+        };
+      },
+    };
+
+    for await (const value of streaming(
+      new Parser().uint8("value"),
+    ).parseStream(source)) {
+      strictEqual(value.value, 0);
+      break;
+    }
+
+    strictEqual(returned, 1);
+  });
+
+  it("rejects writes and duplicate endings after closure", async () => {
+    const stream = streaming(new Parser().uint8("value")).createStream();
+    stream.end();
+
+    await rejects(
+      stream.write(new Uint8Array([1])),
+      (error: ParserStreamError) => {
+        strictEqual(error.code, "STREAM_CLOSED");
+        return true;
+      },
+    );
+    throws(
+      () => stream.end(),
+      (error: ParserStreamError) => {
+        strictEqual(error.code, "STREAM_CLOSED");
+        return true;
+      },
+    );
+  });
+});
